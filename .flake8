[flake8]

extend-ignore =
    ; E203,
    ; E501,

exclude =
    .git,
    .venv,
    __pycache__,
    pytest_cache,
    allure-*,
    logs

per-file-ignores =
    # imported but unused
    __init__.py: F401
    # imported but unused
    tests/test_sample.py: F401

max-complexity = 10
max-line-length = 120
